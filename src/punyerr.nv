// punyerr — every way a label or a domain name can refuse to be
// converted.
//
// One type serves both directions, because the reason a name cannot be
// converted is the same reason either way.  What the variants separate
// is which step refused: UTS #46 maps, normalises, validates, encodes
// or decodes, and checks lengths, and a person debugging a name that
// will not resolve needs to know which step said no.  `error_step`
// answers it.
//
// Most variants name the label they are about, and most name a
// position inside it, because the wrong label of a domain is rarely
// the first one.
//
// A refusal is not a security verdict.  These say a name is not
// well-formed under IDNA, which is a narrower claim than "this name is
// safe to show a person".  Confusable detection is UTS #39, a
// different specification.

// PunyError is why a label or a domain could not be converted.
pub enum PunyError
    // A basic-code-point run was longer than a label may be, or the
    // encoded form came out past 63 characters once the `xn--` prefix
    // was added.
    PunyLabelTooLong(label: Str, len: Int)
    // The whole domain came out past 253 characters.
    PunyDomainTooLong(len: Int)
    // A label was empty and was not the trailing root label.  `a..b` is
    // not a domain name.
    PunyEmptyLabel(at: Int)
    // An encoded label's delta accumulator passed the bound RFC 3492
    // section 6.4 sets.  A wrapped delta decodes to a different string, and a
    // name that decodes two ways is a phishing tool.
    PunyOverflow(label: Str, at: Int)
    // A character in the encoded part of a label was not a
    // base-36 digit.
    PunyBadDigit(label: Str, at: Int, ch: Int)
    // An encoded label's basic part held a character that is not a
    // basic code point, which a punycode encoder cannot have produced.
    PunyNotBasic(label: Str, at: Int, ch: Int)
    // A decoded delta named a code point above 0x10FFFF, or a
    // surrogate.  An unchecked punycode label can name a code point
    // that does not exist.
    PunyBadCodePoint(label: Str, cp: Int)
    // An `xn--` label whose encoded form is not the one an encoder
    // would produce for its own decoded value.  UTS #46 requires the
    // round trip, because two encodings of one name are two names as
    // far as a comparison is concerned.
    PunyNotCanonical(label: Str)
    // An `xn--` label that decoded to something with no non-basic
    // characters in it at all, which an encoder would never have
    // encoded.
    PunyPointlessEncoding(label: Str)
    // A code point UTS #46 marks disallowed appeared in a label.
    PunyDisallowedChar(label: Str, at: Int, cp: Int)
    // A code point that is disallowed only because
    // `use_std3_ascii_rules` is on: an ASCII character outside
    // letters, digits and the hyphen.
    PunyDisallowedStd3(label: Str, at: Int, cp: Int)
    // A label that is not in Unicode Normalization Form C after the
    // mapping step.  UTS #46 requires it, and a caller that skipped
    // normalisation would produce two encodings of one name.
    PunyNotNormalized(label: Str)
    // A label beginning or ending with a hyphen, or carrying hyphens
    // in its third and fourth positions when it is not an `xn--`
    // label.  The `check_hyphens` option turns this off, which is what
    // browsers do.
    PunyBadHyphen(label: Str, at: Int)
    // A label beginning with a combining mark, which UTS #46 forbids
    // regardless of any option.
    PunyLeadingCombiningMark(label: Str, cp: Int)
    // A label that breaks RFC 5893's bidi rule: a right-to-left label
    // in a domain that has one must begin and end with characters of
    // the right directionality, and must not mix certain classes.
    // `which` names the numbered condition of section 2 that failed, so a
    // person can find it.
    PunyBidiRule(label: Str, which: Int)
    // A ZERO WIDTH JOINER or NON-JOINER that did not meet the
    // contextual rule RFC 5892 Appendix A gives it: a joiner must
    // follow a virama or sit between characters of the right joining
    // types.
    PunyContextJ(label: Str, at: Int, cp: Int)
    // A character with a CONTEXTO rule — a middle dot, a Greek
    // keraia, an Arabic-Indic digit mixed with an extended one — that
    // did not meet it.
    PunyContextO(label: Str, at: Int, cp: Int)
    // A `UniData` was handed over that does not carry the tables this
    // step needs.  unicode-nv's compact data omits normalisation and
    // case mapping, and a caller that passed it here would get a
    // silently unnormalised name; this is that refusal instead.
    PunyDataIncomplete(what: Str)

// message renders the refusal as one line of prose, with the label in
// it.
//
// `Result<_, PunyError>` requires this impl: SPEC section 3.4 admits a
// `Result` error type only if it implements `Error`.
impl Error for PunyError
    // Answer the one-line report: which label, what was wrong, and
    // where in it when there is a where.
    //
    // ```novo
    // use punyerr
    //
    // fn main() [io]
    //     let e = PunyEmptyLabel(at: 1)
    //     println(e.message())
    //     // punycode: empty label at position 1; a..b is not a domain
    // ```
    fn message(self) -> Str
        match self
            PunyLabelTooLong(l, n)          => "punycode: label ${l} is ${n} characters, over the 63 a label may hold"
            PunyDomainTooLong(n)            => "punycode: the domain is ${n} characters, over the 253 a name may hold"
            PunyEmptyLabel(at)              => "punycode: empty label at position ${at}; a..b is not a domain"
            PunyOverflow(l, at)             => "punycode: the delta in ${l} overflows at offset ${at}"
            PunyBadDigit(l, at, ch)         => "punycode: character ${ch} at offset ${at} of ${l} is not a base-36 digit"
            PunyNotBasic(l, at, ch)         => "punycode: character ${ch} at offset ${at} of ${l} is not basic"
            PunyBadCodePoint(l, cp)         => "punycode: ${l} decodes to ${cp}, which is not a Unicode scalar value"
            PunyNotCanonical(l)             => "punycode: ${l} is not the encoding an encoder produces for what it decodes to"
            PunyPointlessEncoding(l)        => "punycode: ${l} encodes a label with no non-ASCII character"
            PunyDisallowedChar(l, at, cp)   => "punycode: code point ${cp} at offset ${at} of ${l} is disallowed"
            PunyDisallowedStd3(l, at, cp)   => "punycode: code point ${cp} at offset ${at} of ${l} is disallowed by the STD3 rules"
            PunyNotNormalized(l)            => "punycode: ${l} is not in Normalization Form C"
            PunyBadHyphen(l, at)            => "punycode: the hyphen at offset ${at} of ${l} breaks the hyphen rules"
            PunyLeadingCombiningMark(l, cp) => "punycode: ${l} begins with the combining mark ${cp}"
            PunyBidiRule(l, which)          => "punycode: ${l} breaks condition ${which} of the RFC 5893 bidi rule"
            PunyContextJ(l, at, cp)         => "punycode: the joiner ${cp} at offset ${at} of ${l} is out of context"
            PunyContextO(l, at, cp)         => "punycode: code point ${cp} at offset ${at} of ${l} is out of context"
            PunyDataIncomplete(what)        => "punycode: the Unicode data lacks ${what}"

// The label a refusal is about, or `""` for the three that are about a
// whole domain or its data.
//
// ```novo
// use punyerr
//
// fn main() [io]
//     println(punyerr.error_label(PunyNotCanonical(label: "xn--a")))   // xn--a
// ```
pub fn error_label(e: PunyError) -> Str []
    match e
        PunyLabelTooLong(l, _)         => l
        PunyOverflow(l, _)             => l
        PunyBadDigit(l, _, _)          => l
        PunyNotBasic(l, _, _)          => l
        PunyBadCodePoint(l, _)         => l
        PunyNotCanonical(l)            => l
        PunyPointlessEncoding(l)       => l
        PunyDisallowedChar(l, _, _)    => l
        PunyDisallowedStd3(l, _, _)    => l
        PunyNotNormalized(l)           => l
        PunyBadHyphen(l, _)            => l
        PunyLeadingCombiningMark(l, _) => l
        PunyBidiRule(l, _)             => l
        PunyContextJ(l, _, _)          => l
        PunyContextO(l, _, _)          => l
        _                              => ""

// The position a refusal names, or -1 when it has none: a byte offset
// inside the label, or for `PunyEmptyLabel` the label's index in the
// domain.
//
// -1 rather than 0, because position 0 exists and a caller that
// printed it would have been told something false.
//
// ```novo
// use punyerr
//
// fn main() [io]
//     let a = punyerr.error_offset(PunyBadDigit(label: "xn--a", at: 5, ch: 33))
//     let b = punyerr.error_offset(PunyNotCanonical(label: "xn--a"))
//     println("${a} ${b}")   // 5 -1
// ```
pub fn error_offset(e: PunyError) -> Int []
    match e
        PunyEmptyLabel(at)           => at
        PunyOverflow(_, at)          => at
        PunyBadDigit(_, at, _)       => at
        PunyNotBasic(_, at, _)       => at
        PunyDisallowedChar(_, at, _) => at
        PunyDisallowedStd3(_, at, _) => at
        PunyBadHyphen(_, at)         => at
        PunyContextJ(_, at, _)       => at
        PunyContextO(_, at, _)       => at
        _                            => -1

// Which UTS #46 step refused: `"decode"`, `"map"`, `"normalize"`,
// `"validate"`, `"length"`.  A character the mapping table disallows
// is reported by the validation of its label, and its step is still
// `"map"`, since the table is where its status comes from.
//
// ```novo
// use punyerr
//
// fn main() [io]
//     println(punyerr.error_step(PunyDomainTooLong(len: 300)))   // length
// ```
pub fn error_step(e: PunyError) -> Str []
    match e
        PunyLabelTooLong(_, _)         => "length"
        PunyDomainTooLong(_)           => "length"
        PunyDisallowedChar(_, _, _)    => "map"
        PunyDisallowedStd3(_, _, _)    => "map"
        PunyNotNormalized(_)           => "normalize"
        PunyDataIncomplete(_)          => "normalize"
        PunyEmptyLabel(_)              => "validate"
        PunyBadHyphen(_, _)            => "validate"
        PunyLeadingCombiningMark(_, _) => "validate"
        PunyBidiRule(_, _)             => "validate"
        PunyContextJ(_, _, _)          => "validate"
        PunyContextO(_, _, _)          => "validate"
        _                              => "decode"
