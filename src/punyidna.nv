// punyidna — UTS #46, which is what "IDNA" means in practice.
//
// UTS #46's ToASCII has five steps: map every code point through the
// IDNA Mapping Table, normalise to NFC, split into labels and validate
// each, punycode-encode the ones that need it, and check the lengths.
// A caller that meets a refusal wants to know which step said no, and
// `punyerr.error_step` answers that.
//
// The mapping table, the Bidi_Class of every code point, the
// Joining_Type RFC 5892 reads and the five scripts its CONTEXTO rules
// name are carried here, in the tables at the end of this file, which
// `tools/idna_tables.py` writes.  unicode-nv supplies NFC, the general
// category and the canonical combining class, through a `UniData` the
// caller passes; a caller that passes the compact data, which leaves
// code points above U+FFFF unnormalised, is refused with
// `PunyDataIncomplete` rather than given a silently unnormalised name.
//
// IDNA2003 mapped `ß` to `ss` and `ς` to `σ`; IDNA2008 keeps them as
// themselves, so the same name resolves to two places depending on the
// vintage of the resolver.  UTS #46 calls the four affected characters
// deviations.  Every browser has used nontransitional processing since
// 2016, and UTS #46 itself deprecated transitional processing in
// version 15.1; `transitional()` remains for a program that has to
// agree with something older.
//
// Since version 15.1 the mapping table has no STD3 statuses, and the
// STD3 rules are a separate check on ASCII.  `char_status` answers the
// two older statuses from that check, so that `_` is still
// `disallowed_STD3_valid` as the older tables spell it.
//
// This is not a security check.  UTS #46 says whether a name is
// well-formed; whether `раypal.com` and `paypal.com` look alike is UTS
// #39, a different specification with a different table.

use punyboot
use punycode
use punyerr
use udata
use unorm
use uclass

// What a conversion does and does not check.
//
// Six switches, and the README says which combination each well-known
// consumer uses.
pub struct PunyIdnaOptions
    // Whether the four deviation characters are mapped the IDNA2003
    // way.  False in `nontransitional()`, which is what every browser
    // has used since 2016.
    transitional: Bool
    // Whether an ASCII character outside letters, digits and the
    // hyphen is disallowed.  STD3 is the host-name rule from 1989, and
    // the reason `_` is refused in a host name and allowed in a DNS
    // record.
    use_std3_ascii_rules: Bool
    // Whether a label may begin or end with a hyphen, or carry hyphens
    // in its third and fourth positions.  Browsers turn this off.
    // With it off, a label that is not punycode may still not begin
    // with `xn--`.
    check_hyphens: Bool
    // Whether RFC 5893's bidi rule is applied to a domain that holds
    // any right-to-left character.
    check_bidi: Bool
    // Whether the CONTEXTJ and CONTEXTO rules are applied to joiners
    // and to the characters that carry them.
    check_joiners: Bool
    // Whether the 63-character label and 253-character domain limits
    // are enforced.  A caller converting a name for display rather
    // than for a resolver turns this off.
    verify_dns_length: Bool

// The processing every browser uses: nontransitional, STD3 off,
// hyphens unchecked, bidi and joiners checked, lengths verified.
//
// ```novo
// use punyidna
//
// fn main() [io]
//     println("${punyidna.nontransitional().transitional}")   // false
// ```
pub fn nontransitional() -> PunyIdnaOptions []
    PunyIdnaOptions { transitional: false,
        use_std3_ascii_rules: false,
        check_hyphens: false,
        check_bidi: true,
        check_joiners: true,
        verify_dns_length: true }

// The same with the four deviation characters mapped the IDNA2003
// way.
//
// For a program that has to agree with something old.  `ß` becomes
// `ss` and `ς` becomes `σ`, which means two different names resolve to
// one place — and that a name a user typed is not the name that was
// looked up.
pub fn transitional() -> PunyIdnaOptions []
    PunyIdnaOptions { transitional: true,
        use_std3_ascii_rules: false,
        check_hyphens: false,
        check_bidi: true,
        check_joiners: true,
        verify_dns_length: true }

// Everything on: STD3, hyphen checks, bidi, joiners, lengths, with
// nontransitional processing.
//
// What a registry validating a name somebody wants to buy would use,
// and stricter than any resolver.
pub fn strict() -> PunyIdnaOptions []
    PunyIdnaOptions { transitional: false,
        use_std3_ascii_rules: true,
        check_hyphens: true,
        check_bidi: true,
        check_joiners: true,
        verify_dns_length: true }

// What UTS #46's table says about one code point.
//
// The five statuses of the IdnaMappingTable, plus the two that depend
// on `use_std3_ascii_rules` — which are separate values rather than a
// flag on `PunyDisallowed`, because the distinction is exactly what
// the option decides.
pub enum PunyStatus
    // Allowed, and stands for itself.
    PunyValid
    // Allowed, and stands for something else: the mapped sequence.
    // Most of the table — every upper-case letter, every compatibility
    // form.
    PunyMapped
    // Removed entirely.  Soft hyphen, the variation selectors, and the
    // zero-width characters that are not joiners.
    PunyIgnored
    // One of the four characters IDNA2003 and IDNA2008 disagree about:
    // `ß`, `ς`, ZERO WIDTH JOINER, ZERO WIDTH NON-JOINER.  Mapped
    // under `transitional`, valid under `nontransitional`.
    PunyDeviation
    // Not allowed in a name at all.
    PunyDisallowed
    // Valid when `use_std3_ascii_rules` is off and disallowed when it
    // is on: `_`, and the other ASCII punctuation.
    PunyDisallowedStd3Valid
    // Mapped when `use_std3_ascii_rules` is off and disallowed when it
    // is on.
    PunyDisallowedStd3Mapped

// The status's name, for a refusal and for a table dump:
// `"valid"`, `"mapped"`, `"ignored"`, `"deviation"`, `"disallowed"`,
// `"disallowed_STD3_valid"`, `"disallowed_STD3_mapped"`.
//
// The spellings the IdnaMappingTable itself uses, so a reader can grep
// the data file with what this prints.
pub fn status_name(s: PunyStatus) -> Str []
    match s
        PunyValid                => "valid"
        PunyMapped               => "mapped"
        PunyIgnored              => "ignored"
        PunyDeviation            => "deviation"
        PunyDisallowed           => "disallowed"
        PunyDisallowedStd3Valid  => "disallowed_STD3_valid"
        PunyDisallowedStd3Mapped => "disallowed_STD3_mapped"

// What the table says about one code point.
//
// ```novo
// use punyidna
// use udata
//
// fn main() [io]
//     let d = udata.data_full()
//     println(punyidna.status_name(punyidna.char_status(d, 0x41)))   // mapped
// ```
pub fn char_status(d: UniData, cp: Int) -> PunyStatus []
    let at = entry_of(cp)
    let letter = byte(UTS46, at * 8 + 3)
    if letter == 'V'
        if cp < 0x80 and not is_ldh(cp) and cp != '.'
            return PunyDisallowedStd3Valid
        return PunyValid
    if letter == 'M'
        if list.any(replacement(at), c => c < 0x80 and not is_ldh(c) and c != '.')
            return PunyDisallowedStd3Mapped
        return PunyMapped
    if letter == 'D'
        return PunyDeviation
    if letter == 'I'
        return PunyIgnored
    PunyDisallowed

// What one code point maps to under these options: itself, nothing, or
// a sequence.
//
// An empty list for an ignored character.  A deviation maps to itself
// under `nontransitional` and to its IDNA2003 value under
// `transitional`, which is the whole of the difference between the
// two.
pub fn map_char(d: UniData, cp: Int, o: PunyIdnaOptions) -> [Int] []
    let at = entry_of(cp)
    let letter = byte(UTS46, at * 8 + 3)
    if letter == 'M' or letter == 'D' and o.transitional
        return replacement(at)
    if letter == 'I'
        return []
    [cp]

// ── the five steps, each on its own ─────────────────────────────────

// Step one and two: map every code point, then normalise to NFC.
//
// Published separately because a caller that wants to show a person
// what a name became needs the mapped form before the labels are
// split.  A disallowed code point is kept here and refused when its
// label is validated.  Refused with `PunyDataIncomplete` for the
// compact data, which does not normalise above U+FFFF.
//
// ```novo
// use punyidna
// use udata
//
// fn main() [io]
//     match punyidna.map(udata.data_full(), "Bücher。EXAMPLE", punyidna.nontransitional())
//         Ok(s)  => println(s)   // bücher.example
//         Err(e) => println(e.message())
// ```
pub fn map(d: UniData, input: Str, o: PunyIdnaOptions) -> Result<Str, PunyError> []
    if not d.complete
        return Err(PunyDataIncomplete("normalisation above U+FFFF"))
    let mapped = list.flat_map(punycode.code_points(input), c => map_char(d, c, o))
    Ok(unorm.normalize(d, punycode.text_of(mapped), FormNfc))

// Step three, for one label: everything UTS #46 section 4.1 requires of a
// label that has already been mapped and normalised.
//
// `None` when the label is valid.  In order: it is in NFC; it does not
// begin with a combining mark; it does not break the hyphen rules; it
// holds no full stop, and every character is `PunyValid`, or a
// `PunyDeviation` under nontransitional processing, or an ASCII
// character the STD3 rules refuse when they are off; the joiner rules
// hold when `check_joiners` is on; and the bidi rule holds when
// `check_bidi` is on and the label has a right-to-left character,
// since a label on its own is the whole of the domain it is checked
// against.
//
// ```novo
// use punyidna
// use udata
//
// fn main() [io]
//     match punyidna.validate_label(udata.data_full(), "a_b", punyidna.strict())
//         Some(e) => println(e.message())
//         None    => println("valid")
// ```
pub fn validate_label(d: UniData, label: Str, o: PunyIdnaOptions) -> ?PunyError []
    validate(d, label, o, o.check_bidi and is_bidi_domain(d, label))

// RFC 5893's bidi rule, on its own.
//
// An empty label passes.  The Bidi_Class of each code point comes from
// the table this package carries.
//
// Six numbered conditions, and `PunyBidiRule` carries which of them
// failed so that a person can find it in the RFC.  It applies to a
// label only when the domain contains a right-to-left character
// anywhere — which is why it takes the domain's own answer rather than
// deciding per label, and why `is_bidi_domain` is published beside it.
pub fn bidi_rule(d: UniData, label: Str) -> ?PunyError []
    let classes = list.map(punycode.code_points(label), c => bidi_class(c))
    let n = list.len(classes)
    if n == 0
        return None
    let first = classes[0]
    if first != B_L and first != B_R and first != B_AL
        return Some(PunyBidiRule(label, 1))
    let last = last_strong(classes)
    if first == B_L
        if not list.all(classes,
            c => c == B_L or c == B_EN or c == B_ES or c == B_CS or c == B_ET or c == B_ON or c == B_BN or c == B_NSM)
            return Some(PunyBidiRule(label, 5))
        if last != B_L and last != B_EN
            return Some(PunyBidiRule(label, 6))
        return None
    if not list.all(classes,
        c => c == B_R or c == B_AL or c == B_AN or c == B_EN or c == B_ES or c == B_CS or c == B_ET or c == B_ON or c == B_BN or c == B_NSM)
        return Some(PunyBidiRule(label, 2))
    if last != B_R and last != B_AL and last != B_EN and last != B_AN
        return Some(PunyBidiRule(label, 3))
    if list.contains(classes, B_EN) and list.contains(classes, B_AN)
        return Some(PunyBidiRule(label, 4))
    None

// Whether a domain contains any right-to-left character, and so
// whether the bidi rule applies to its labels at all.
//
// The scoping decision RFC 5893 makes: a purely left-to-right domain
// is not subject to the rule, and applying it anyway would refuse
// perfectly good names.
pub fn is_bidi_domain(d: UniData, domain: Str) -> Bool []
    list.any(punycode.code_points(domain), c => is_rtl(bidi_class(c)))

// RFC 5892 Appendix A's CONTEXTJ rules: ZERO WIDTH JOINER and ZERO
// WIDTH NON-JOINER.
//
// Both are invisible and both are necessary — Persian and several
// Indic scripts need them to render correctly — so they are allowed
// under a context rule rather than banned.  The rule is that a joiner
// must follow a virama, or sit between characters whose joining types
// permit it.
pub fn contextj_rule(d: UniData, label: Str) -> ?PunyError []
    let cps = punycode.code_points(label)
    var offset = 0
    for i in 0..list.len(cps)
        let c = cps[i]
        if (c == 0x200C or c == 0x200D) and not joiner_ok(d, cps, i)
            return Some(PunyContextJ(label, offset, c))
        offset = offset + str.len(str.from_char(c))
    None

// RFC 5892 Appendix A's CONTEXTO rules.
//
// The characters that are allowed only in the company of particular
// others: MIDDLE DOT between two `l`s (Catalan), the Greek keraia
// before a Greek letter, the Hebrew geresh after a Hebrew letter,
// Katakana middle dot in company with Japanese script, and the two
// Arabic-Indic digit blocks which may not be mixed.
//
// UTS #46 leaves this one optional where CONTEXTJ is required, and
// both are under `check_joiners` here rather than under two flags,
// because a caller that wanted one and not the other has not been
// observed.
pub fn contexto_rule(d: UniData, label: Str) -> ?PunyError []
    let cps = punycode.code_points(label)
    var offset = 0
    for i in 0..list.len(cps)
        let c = cps[i]
        if not contexto_ok(cps, i)
            return Some(PunyContextO(label, offset, c))
        offset = offset + str.len(str.from_char(c))
    None

// ── the two conversions ─────────────────────────────────────────────

// A whole domain to its ASCII form: the name a resolver is given.
//
// The five steps in order.  A label that needs punycode comes back
// `xn--`-prefixed; one that does not comes back as it was, which is
// what makes an ASCII domain cost nothing.
//
// ```novo
// use punyidna
// use udata
//
// fn main() [io]
//     let d = udata.data_full()
//     match punyidna.to_ascii(d, "bücher.example", punyidna.nontransitional())
//         Ok(s)  => println(s)   // xn--bcher-kva.example
//         Err(e) => println(e.message())
// ```
pub fn to_ascii(d: UniData, domain: Str, o: PunyIdnaOptions) -> Result<Str, PunyError> []
    match to_ascii_labels(d, domain, o)
        Err(e)     => Err(e)
        Ok(labels) =>
            let out = join_labels(labels)
            if o.verify_dns_length
                if let Some(e) = length_fault(labels, out)
                    return Err(e)
            Ok(out)

// The same, written through the caller's cursor, answering how many
// characters were written.
//
// The form url-nv's host parser wants: it assembles a URL in one
// buffer.  The cursor panics if the buffer is too small, as every
// cursor write does.
pub fn to_ascii_into(d: UniData, domain: Str, o: PunyIdnaOptions,
                     var dst: Cursor) -> Result<Int, PunyError> []
    match to_ascii(d, domain, o)
        Err(e) => Err(e)
        Ok(s)  =>
            dst.put_bytes(bytes.from_str(s))
            Ok(str.len(s))

// A whole domain to its Unicode form: the name a person is shown.
//
// Every `xn--` label is decoded and validated; a label that decodes to
// something invalid is left as it was rather than refused, which is
// what UTS #46 requires — `ToUnicode` never fails, because refusing to
// display a name is worse than displaying it in its encoded form.
// `PunyError` is still in the signature for the length and structural
// refusals that happen before any label is looked at.
pub fn to_unicode(d: UniData, domain: Str, o: PunyIdnaOptions) -> Result<Str, PunyError> []
    match map(d, domain, o)
        Err(e)     => Err(e)
        Ok(mapped) => Ok(join_labels(list.map(split_labels(mapped), l => shown(d, l, o))))

// The same, written through the caller's cursor as UTF-8, answering
// how many characters were written, counted in code points.
pub fn to_unicode_into(d: UniData, domain: Str, o: PunyIdnaOptions,
                       var dst: Cursor) -> Result<Int, PunyError> []
    match to_unicode(d, domain, o)
        Err(e) => Err(e)
        Ok(s)  =>
            dst.put_bytes(bytes.from_str(s))
            Ok(list.len(punycode.code_points(s)))

// One label to its ASCII form.
//
// For a caller that has already split a domain, such as a DNS resolver
// walking a name or a certificate matcher comparing one label against
// a wildcard.  A label whose mapping holds a full stop, such as one
// written with IDEOGRAPHIC FULL STOP, is refused.  The length limits
// are not checked.
pub fn label_to_ascii(d: UniData, label: Str, o: PunyIdnaOptions) -> Result<Str, PunyError> []
    match map(d, label, o)
        Err(e)     => Err(e)
        Ok(mapped) =>
            if str.contains(mapped, ".")
                let at = str.index(mapped, ".") ?? 0
                return Err(PunyDisallowedChar(mapped, at, '.'))
            ascii_label(d, mapped, o, o.check_bidi and is_bidi_domain(d, mapped))

// One label to its Unicode form: decoded when it is valid punycode, and
// as it was mapped otherwise.
pub fn label_to_unicode(d: UniData, label: Str, o: PunyIdnaOptions) -> Result<Str, PunyError> []
    match map(d, label, o)
        Err(e)     => Err(e)
        Ok(mapped) => Ok(shown(d, mapped, o))

// ── labels ──────────────────────────────────────────────────────────

// A domain split on `.`, with the separators removed.
//
// UTS #46 treats three other characters as full stops — IDEOGRAPHIC
// FULL STOP, FULLWIDTH FULL STOP, HALFWIDTH IDEOGRAPHIC FULL STOP —
// and they are mapped to `.` in the mapping step, so a caller that
// splits BEFORE mapping gets a different answer from one that splits
// after.  This function splits on `.` alone and the order of the steps
// is what makes that correct.
//
// ```novo
// use punyidna
//
// fn main() [io]
//     let n = punyidna.split_labels("a.b.c").len()
//     println("${n}")   // 3
// ```
pub fn split_labels(domain: Str) -> [Str] []
    str.split(domain, ".")

// Labels joined with `.`.
pub fn join_labels(labels: [Str]) -> Str []
    str.join(labels, ".")

// How many characters the ASCII form of this domain would occupy.
//
// For a caller sizing a buffer before `to_ascii_into`, and for one
// deciding whether a name will fit before it commits to converting it.
pub fn ascii_len(d: UniData, domain: Str, o: PunyIdnaOptions) -> Result<Int, PunyError> []
    match to_ascii(d, domain, o)
        Ok(s)  => Ok(str.len(s))
        Err(e) => Err(e)

// Whether a domain's ASCII form is within the DNS length limits: every
// label at most 63 characters and the whole name at most 253.
//
// A predicate rather than a refusal, for a caller that wants to offer
// a person a name and say whether it can be registered.  The limits
// are checked whatever `verify_dns_length` says, and a name that does
// not convert at all does not fit.
pub fn fits_dns(d: UniData, domain: Str, o: PunyIdnaOptions) -> Bool []
    let checked = PunyIdnaOptions { transitional: o.transitional,
        use_std3_ascii_rules: o.use_std3_ascii_rules,
        check_hyphens: o.check_hyphens,
        check_bidi: o.check_bidi,
        check_joiners: o.check_joiners,
        verify_dns_length: true }
    match to_ascii(d, domain, checked)
        Ok(_)  => true
        Err(_) => false

// ── what url-nv asks for ────────────────────────────────────────────

// A URL's host to its ASCII form, ready for a resolver.
//
// The one call url-nv's host parser makes, named so that both packages
// can point at it.  Its `host_problem` refuses a byte above 127 with
// `E_IDNA` today; with this package it calls `host_to_ascii` on the
// host span instead and re-runs its own forbidden-byte check on the
// result, which is exactly what the WHATWG URL standard's host parser
// does.
//
// It uses `url_options()`, which is not `strict()`: a URL host is not a
// registry application, and refusing `_` would break a great deal of
// deployed naming.
pub fn host_to_ascii(d: UniData, host: Str) -> Result<Str, PunyError> []
    to_ascii(d, host, url_options())

// A URL's host to its display form, for showing a person.
//
// The other half of what a browser's address bar does: the resolver
// gets `host_to_ascii` and the person sees this.  It never fails on a
// label, for the reason `to_unicode` gives.
pub fn host_to_unicode(d: UniData, host: Str) -> Result<Str, PunyError> []
    to_unicode(d, host, url_options())

// The options the WHATWG URL standard's host parser uses, as a value.
//
// Nontransitional, the STD3 rules off, the hyphen checks off, bidi and
// joiners checked, and the DNS lengths not verified, since the WHATWG
// standard verifies them only when a host is checked strictly.
// Published so that url-nv does not have to spell the combination out.
//
// ```novo
// use punyidna
//
// fn main() [io]
//     println("${punyidna.url_options().verify_dns_length}")   // false
// ```
pub fn url_options() -> PunyIdnaOptions []
    PunyIdnaOptions { transitional: false,
        use_std3_ascii_rules: false,
        check_hyphens: false,
        check_bidi: true,
        check_joiners: true,
        verify_dns_length: false }

// The Bidi_Class values the bidi rule reads, numbered as the BIDI table
// numbers them.
const B_L: Int = 0
const B_R: Int = 1
const B_AL: Int = 2
const B_EN: Int = 3
const B_ES: Int = 4
const B_ET: Int = 5
const B_AN: Int = 6
const B_CS: Int = 7
const B_NSM: Int = 8
const B_BN: Int = 9
const B_ON: Int = 13

// The Joining_Type values of the JOIN table.
const J_D: Int = 2
const J_L: Int = 3
const J_R: Int = 4
const J_T: Int = 5

// The scripts of the SCRIPT table.
const S_GREEK: Int = 1
const S_HEBREW: Int = 2

// One byte of a table.
fn byte(t: Str, at: Int) -> Int
    str.byte_at_or(t, at, 0)

// A big-endian number of `width` bytes of a table.
fn number(t: Str, at: Int, width: Int) -> Int
    list.fold(list.range(at, at + width), (n, i) => n * 256 + str.byte_at_or(t, i, 0), 0)

// The index of the last entry of a covering table whose first code
// point is at or below `cp`.  The first entry of every table starts at
// U+0000, so there always is one.
fn cover(t: Str, entries: Int, size: Int, cp: Int) -> Int
    var lo = 0
    var hi = entries - 1
    for _ in 0..32
        if lo >= hi
            break
        let mid = (lo + hi + 1) / 2
        if number(t, mid * size, 3) <= cp
            lo = mid
        else
            hi = mid - 1
    lo

// The UTS46 entry that covers `cp`.
fn entry_of(cp: Int) -> Int
    cover(UTS46, UTS46_ENTRIES, 8, cp)

// The replacement an UTS46 entry carries, as code points.
fn replacement(at: Int) -> [Int]
    let offset = number(UTS46, at * 8 + 4, 3)
    let count = byte(UTS46, at * 8 + 7)
    list.map(list.range(offset, offset + count), k => number(REPL, k * 3, 3))

// The Bidi_Class of a code point.
fn bidi_class(cp: Int) -> Int
    byte(BIDI, cover(BIDI, BIDI_ENTRIES, 4, cp) * 4 + 3)

// The Joining_Type of a code point, 0 when it has none.
fn joining_type(cp: Int) -> Int
    byte(JOIN, cover(JOIN, JOIN_ENTRIES, 4, cp) * 4 + 3)

// The CONTEXTO script of a code point, 0 for any other script.
fn script_of(cp: Int) -> Int
    byte(SCRIPT, cover(SCRIPT, SCRIPT_ENTRIES, 4, cp) * 4 + 3)

// Whether a code point is an ASCII letter, digit or hyphen.
fn is_ldh(cp: Int) -> Bool
    cp >= 'a' and cp <= 'z' or cp >= 'A' and cp <= 'Z' or cp >= '0' and cp <= '9' or cp == '-'

// Whether a Bidi_Class makes a label right-to-left.
fn is_rtl(c: Int) -> Bool
    c == B_R or c == B_AL or c == B_AN

// The last class of a label that is not NSM.
fn last_strong(classes: [Int]) -> Int
    list.fold(classes, (last, c) => (if c == B_NSM then last else c), B_NSM)

// UTS #46 section 4.1 over one mapped label, with the bidi rule applied
// when `bidi` says the domain is a bidi domain.
fn validate(d: udata.UniData, label: Str, o: PunyIdnaOptions, bidi: Bool) -> ?punyerr.PunyError
    if not unorm.is_normalized(d, label, FormNfc)
        return Some(PunyNotNormalized(label))
    let cps = punycode.code_points(label)
    if list.len(cps) > 0 and uclass.is_mark(cps[0])
        return Some(PunyLeadingCombiningMark(label, cps[0]))
    if let Some(e) = hyphen_fault(label, o)
        return Some(e)
    var offset = 0
    for c in cps
        if let Some(e) = char_fault(d, label, offset, c, o)
            return Some(e)
        offset = offset + str.len(str.from_char(c))
    if o.check_joiners
        if let Some(e) = contextj_rule(d, label)
            return Some(e)
        if let Some(e) = contexto_rule(d, label)
            return Some(e)
    if bidi
        return bidi_rule(d, label)
    None

// The hyphen rules: with `check_hyphens` on, no hyphen first, last, or
// in the third and fourth positions together; with it off, no `xn--`
// at the start of a label that is not punycode.
fn hyphen_fault(label: Str, o: PunyIdnaOptions) -> ?punyerr.PunyError
    let n = str.len(label)
    if not o.check_hyphens
        if punycode.is_encoded_label(label)
            return Some(PunyBadHyphen(label, 0))
        return None
    if n >= 4 and str.slice(label, 2, 4) == "--"
        return Some(PunyBadHyphen(label, 2))
    if str.starts_with(label, "-")
        return Some(PunyBadHyphen(label, 0))
    if str.ends_with(label, "-")
        return Some(PunyBadHyphen(label, n - 1))
    None

// Whether one code point of a mapped label is allowed by the table and
// the options.
fn char_fault(d: udata.UniData, label: Str, offset: Int, c: Int,
              o: PunyIdnaOptions) -> ?punyerr.PunyError
    if c == '.'
        return Some(PunyDisallowedChar(label, offset, c))
    match char_status(d, c)
        PunyValid               => None
        PunyDeviation           => if o.transitional
            Some(PunyDisallowedChar(label, offset, c))
        else
            None
        PunyDisallowedStd3Valid => if o.use_std3_ascii_rules
            Some(PunyDisallowedStd3(label, offset, c))
        else
            None
        _                       => Some(PunyDisallowedChar(label, offset, c))

// RFC 5892 appendix A.1 and A.2: a joiner after a virama, or a ZERO
// WIDTH NON-JOINER between a left-joining and a right-joining
// character with only transparent ones around it.
fn joiner_ok(d: udata.UniData, cps: [Int], i: Int) -> Bool
    if i > 0 and unorm.combining_class(d, cps[i - 1]) == 9
        return true
    if cps[i] == 0x200D
        return false
    var left = false
    var k = i - 1
    for _ in 0..i
        let t = joining_type(cps[k])
        if t != J_T
            left = t == J_L or t == J_D
            break
        k = k - 1
    var right = false
    var j = i + 1
    for _ in i + 1..list.len(cps)
        let t = joining_type(cps[j])
        if t != J_T
            right = t == J_R or t == J_D
            break
        j = j + 1
    left and right

// RFC 5892 appendix A.3 to A.9 for the code point at `i`.
fn contexto_ok(cps: [Int], i: Int) -> Bool
    let c = cps[i]
    let n = list.len(cps)
    if c == 0x00B7
        return i > 0 and i < n - 1 and cps[i - 1] == 'l' and cps[i + 1] == 'l'
    if c == 0x0375
        return i < n - 1 and script_of(cps[i + 1]) == S_GREEK
    if c == 0x05F3 or c == 0x05F4
        return i > 0 and script_of(cps[i - 1]) == S_HEBREW
    if c == 0x30FB
        return list.any(cps, x => x != 0x30FB and script_of(x) >= 3)
    if c >= 0x0660 and c <= 0x0669
        return not list.any(cps, x => x >= 0x06F0 and x <= 0x06F9)
    if c >= 0x06F0 and c <= 0x06F9
        return not list.any(cps, x => x >= 0x0660 and x <= 0x0669)
    true

// Steps one to four over a whole domain: map, split, and convert and
// validate each label.
fn to_ascii_labels(d: udata.UniData, domain: Str,
                   o: PunyIdnaOptions) -> Result<[Str], punyerr.PunyError>
    match map(d, domain, o)
        Err(e)     => Err(e)
        Ok(mapped) =>
            let labels = split_labels(mapped)
            let n = list.len(labels)
            for i in 0..n
                if labels[i] == "" and (i < n - 1 or n == 1)
                    return Err(PunyEmptyLabel(i))
            let shown_form = join_labels(list.map(labels, l => decoded_or_self(l)))
            let bidi = o.check_bidi and is_bidi_domain(d, shown_form)
            var out: [Str] = []
            for l in labels
                match ascii_label(d, l, o, bidi)
                    Err(e) =>
                        return Err(e)
                    Ok(a)  => list.push(out, a)
            Ok(out)

// A label decoded when it is punycode that decodes, and itself
// otherwise.
fn decoded_or_self(label: Str) -> Str
    match punycode.decode_label(label)
        Ok(u)  => u
        Err(_) => label

// One mapped label to its ASCII form.
fn ascii_label(d: udata.UniData, label: Str, o: PunyIdnaOptions,
               bidi: Bool) -> Result<Str, punyerr.PunyError>
    if label == ""
        return Ok(label)
    if not punycode.is_encoded_label(label)
        if let Some(e) = validate(d, label, o, bidi)
            return Err(e)
        if list.all(punycode.code_points(label), c => c < 0x80)
            return Ok(label)
        match punycode.encode(label)
            Ok(s)  =>
                return Ok(punycode.ace_prefix() + s)
            Err(e) =>
                return Err(e)
    if let Some(e) = encoded_fault(d, label, o, bidi)
        return Err(e)
    Ok(label)

// What is wrong with an `xn--` label, if anything: a byte that is not
// ASCII, a body that does not decode, a decoding with nothing to
// encode, an encoding an encoder would not produce, or a decoded label
// that is not valid under nontransitional processing.
fn encoded_fault(d: udata.UniData, label: Str, o: PunyIdnaOptions, bidi: Bool) -> ?punyerr.PunyError
    for i in 0..str.len(label)
        let b = str.byte_at_or(label, i, 0)
        if b >= 0x80
            return Some(PunyNotBasic(label, i, b))
    let body = str.slice(label, 4, str.len(label))
    match punycode.decode(body)
        Err(e) => Some(e)
        Ok(u)  =>
            if list.all(punycode.code_points(u), c => c < 0x80)
                return Some(PunyPointlessEncoding(label))
            if not punycode.is_canonical(label)
                return Some(PunyNotCanonical(label))
            let plain = PunyIdnaOptions { transitional: false,
                use_std3_ascii_rules: o.use_std3_ascii_rules,
                check_hyphens: o.check_hyphens,
                check_bidi: o.check_bidi,
                check_joiners: o.check_joiners,
                verify_dns_length: o.verify_dns_length }
            validate(d, u, plain, bidi)

// One mapped label as a person is shown it: decoded when it is valid
// punycode, and as it was otherwise.
fn shown(d: udata.UniData, label: Str, o: PunyIdnaOptions) -> Str
    if not punycode.is_encoded_label(label)
        return label
    match encoded_fault(d, label, o, false)
        Some(_) => label
        None    => decoded_or_self(label)

// The first length the DNS refuses: a label over 63 characters, or a
// name over 253 without its trailing root dot.
fn length_fault(labels: [Str], joined: Str) -> ?punyerr.PunyError
    for l in labels
        if str.len(l) > punyboot.max_label_len()
            return Some(PunyLabelTooLong(l, str.len(l)))
    let total = if str.ends_with(joined, ".")
        str.len(joined) - 1
    else
        str.len(joined)
    if total > punyboot.max_domain_len()
        return Some(PunyDomainTooLong(total))
    None

// The IDNA tables.
//
// Written by tools/idna_tables.py: the IDNA Mapping Table of UTS #46
// version 18.0.0 from the `idna` package 3.20, and the Bidi_Class of
// Unicode 15.0.0.  Each constant is a run of big-endian entries, and
// the script says what each field is.

