// embedded_probe.nv — `punyboot` on a microcontroller, as a program that
// builds for a Cortex-M, boots there and checks its answers.
//
// It is built with
//
//   novo build --target=nrf52-qemu tests/embedded_probe.nv
//
// which produces a Cortex-M4 executable or fails.  `--target=nrf52-qemu`
// stamps `@tier(embedded)` on every function it compiles, so a `Str`, a
// list literal or an unbounded loop in `punyboot` is refused where it is
// written.  The same executable boots under
//
//   qemu-system-arm -machine mps2-an386 -nographic -semihosting -kernel probe.elf
//
// and prints `PASS: punycode-embedded` when every check below holds.
//
// The label is RFC 3492 section 7.1's German sample without its prefix,
// `bcher-kva`, held in a `@value` struct because a `[u8; 9]` is an inline
// array only inside one.  The probe decodes its one delta to U+00FC at
// position 1, and encodes the same delta back to `kva`.
//
// `punycode`, `punyidna` and `punyerr` are not used.  They speak `Str`
// and `Cursor`, and one host-only function anywhere in a compilation
// unit is an undefined symbol at link time on a device.

use punyboot

// The label, as firmware holds one it was handed.
@value
struct ProbeLabel
    b: [u8; 9]

// `bcher-kva`.
@tier(rt)
fn probe_label() -> ProbeLabel
    ProbeLabel { b: ['b' as u8,
        'c' as u8,
        'h' as u8,
        'e' as u8,
        'r' as u8,
        '-' as u8,
        'k' as u8,
        'v' as u8,
        'a' as u8] }

// Every answer this probe checks, counted, so a single comparison
// decides the run and a device that disagrees with the host says how
// many checks it lost.
@tier(rt)
fn score() -> Int
    let p = punyboot.params()
    var n = 0
    if p.base == 36 and p.initial_n == 128 and punyboot.delimiter() == '-'
        n = n + 1
    if punyboot.threshold(36, 72, p) == 1 and punyboot.adapt(p.damp, 1, true, p) == 1
        n = n + 1

    // The delimiter is the last hyphen: position 5.
    let label = probe_label()
    var cut = -1
    for i in 0..9
        if (label.b[i] as Int) == punyboot.delimiter()
            cut = i
    if cut == 5
        n = n + 1

    // Decode the digits after it: one delta, inserting U+00FC at 1.
    let before = punyboot.state(cut, p)
    var scan = punyboot.digit_scan(before.delta, p)
    for i in 6..9
        scan = punyboot.digit_push(scan, label.b[i] as Int, before.bias, p)
    if scan.done and not scan.bad
        n = n + 1
    let scanned = PunyState { n: before.n,
        delta: scan.delta,
        bias: before.bias,
        h: before.h,
        first: before.first,
        bad: false }
    let ins = punyboot.insertion(scanned, cut + 1, p)
    if ins.n == 0xFC and ins.i == 1 and not ins.bad
        n = n + 1
    let after = punyboot.after_insertion(before, ins, cut + 1, p)
    if after.h == 6 and not after.bad
        n = n + 1

    // Encode the same character back: the jump to U+00FC over six code
    // points, one skipped `b`, and the digits `kva`.
    var enc = punyboot.advance_to(punyboot.state(5, p), 0xFC, p)
    enc = punyboot.skip(enc, p)
    let em = punyboot.emit_delta(enc.delta, enc.bias, p)
    if em.ok and em.len == 3 and (em.out[0] as Int) == 'k' and (em.out[1] as Int) == 'v' and (em.out[2] as Int) == 'a'
        n = n + 1
    n

@tier(rt)
fn main() [hw, time]
    bsp.board.init()
    // 7 is the number of checks in `score`.
    if score() == 7
        hal.uart.write("PASS: punycode-embedded\n")
    else
        hal.uart.write("FAIL: punycode-embedded\n")
    loop
        core.rt.sleep_ms(1000)
